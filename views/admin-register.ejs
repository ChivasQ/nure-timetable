<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8">
    <title>Додати адміністратора</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container-fluid">
            <a class="navbar-brand" href="/admin">🔧 CIST Admin</a>
            <div>
                <a href="/admin" class="btn btn-outline-light btn-sm">Назад</a>
            </div>
        </div>
    </nav>

    <div class="container d-flex justify-content-center">
        <div class="card p-4 shadow" style="width: 400px;">
            <h4 class="mb-3 text-center">Новий користувач</h4>

            <% if (error) { %>
                <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <form action="/admin/users/add" method="POST">
                <div class="mb-3">
                    <label>Логін</label>
                    <input type="text" name="username" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label>Email</label>
                    <input type="email" name="email" class="form-control needs-validation" required>
                </div>
                <div class="mb-3">
                    <label>Пароль</label>
                    <input type="password" name="password" class="form-control" required>
                </div>
                <button type="submit" class="btn btn-success w-100">Створити</button>
            </form>
        </div>
    </div>
    <script>
        (function () {
        'use strict'
        
        var forms = document.querySelectorAll('.needs-validation')
       
        Array.prototype.slice.call(forms)
            .forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                event.preventDefault()
                event.stopPropagation()
                }
        
                form.classList.add('was-validated')
            }, false)
            })
        })()
    </script>
</body>
</html>